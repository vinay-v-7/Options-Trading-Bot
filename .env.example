# DhanHQ credentials (required for live scan)
# Get these from your Dhan developer / API console. Tokens expire; refresh as needed.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Capital budget used by scan/status defaults (override with CLI --budget)
TOTAL_CAPITAL=30000

# Optional risk / sizing knobs (defaults match src/config/settings.py)
# MAX_POSITIONS=3
